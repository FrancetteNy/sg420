
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI%20Toolkit/USS/Encyclopedia.uss?fileID=7433441132597879392&amp;guid=c72bc6add74bfd44c9618da8f32e605d&amp;type=3#Encyclopedia" />
    <Style src="project://database/Assets/Resources/UI%20Toolkit/USS/DetailView.uss?fileID=7433441132597879392&amp;guid=5a6aaa73482568247a7b6bebc707b661&amp;type=3#DetailView" />
    <ui:VisualElement enabled="true" name="Trocknen" class="EncyclopediaEntry" >
        <ui:Label class="h1" text="Trocknen der Pflanze"/>
        <ui:Label class="paragraph" text="Nach der Ernte muss die Pflanze getrocknet werden. Die bewährteste Methode ist das kopfüber Trocknen. Die einzelnen Teile, oder die ganzen Pflanzen, werden in einem dunklen und warmen Raum kopfüber aufgehängt. Optimale Bedingungen zum Trocknen hat man bei 15-20°C und einer relativen Luftfeuchtigkeit von 30-50%. Ein Indikator für eine abgeschlossene Trocknung sind Zweige, die sich nicht mehr biegen lassen, sondern beim Versuch, sie zu biegen, brechen."/>
    </ui:VisualElement>
</ui:UXML>