
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI%20Toolkit/USS/Encyclopedia.uss?fileID=7433441132597879392&amp;guid=c72bc6add74bfd44c9618da8f32e605d&amp;type=3#Encyclopedia" />
    <Style src="project://database/Assets/Resources/UI%20Toolkit/USS/DetailView.uss?fileID=7433441132597879392&amp;guid=5a6aaa73482568247a7b6bebc707b661&amp;type=3#DetailView" />
    <ui:VisualElement enabled="true" name="Ernten" class="EncyclopediaEntry" >
        <ui:Label class="h1" text="Ernten"/>
        <ui:Label class="h2" text="Vorbereitung"/>
        <ui:Label class="paragraph" text="Nach dem der erntezeitpunkt bestimmt ist, sollten noch ein paar vorberietungen Getroffen werden. Spätestens eine woche vor der ernte sollte die pflanze keinen dünger mehr erhalten. In den Zwei Tagen vor der Ernte sollte auch nicht mehr Gegossen werden. Ab diesem Zeitpunkt kann man indoor auch die Lampen auch komplett ausschalten."/>
        <ui:Label class="h2" text="Wie Ernte ich eine Cannabispflanze"/>
        <ui:Label class="paragraph" text="Nach den vorbeitungen kann die Pflanze am Stiel gekappt und zum trocknen Zerkleinert werden. Am besten arbeitet man mit handschuhen und Sterilem werkzeug. Je kleiner die Stücke in die man die Pflanze einteilt und je mehr Fächerblätter man Abschneidet, desto Schneller Trocknet die Pflanze. Ein zu schnelles trocknen kann allerdings die qualität des Endprodukts vermindern."/>
    </ui:VisualElement>
</ui:UXML>