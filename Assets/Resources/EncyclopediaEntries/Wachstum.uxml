
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI%20Toolkit/USS/Encyclopedia.uss?fileID=7433441132597879392&amp;guid=c72bc6add74bfd44c9618da8f32e605d&amp;type=3#Encyclopedia" />
    <Style src="project://database/Assets/Resources/UI%20Toolkit/USS/DetailView.uss?fileID=7433441132597879392&amp;guid=5a6aaa73482568247a7b6bebc707b661&amp;type=3#DetailView" />
    <ui:VisualElement enabled="true" name="Wachstum" class="EncyclopediaEntry" >
        <ui:Label class="h1" text="Wachstumsphase"/>
        <ui:Label class="paragraph" text="In der Wachstumsphase bereitet sich die Pflanze auf die Blüte vor. Herschen in der Wachstumsphase gute Bedingungen, wird die Pflanze groß und gesund. Je gesünder die Pflanze in dieser Zeit ist, desto besser sind sie auf die Blüte und eine reiche Ernte vorbereitet."/>
        <ui:Box class="image-box">
            <ui:Image class="image" style="--unity-image: url('Images/vegetative-state.jpg'); height: 515px; width: 400px;" />
            <ui:Label text="Pflanze in der Wachstumsphase" />
        </ui:Box>
    </ui:VisualElement>
</ui:UXML>