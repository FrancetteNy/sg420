<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI%20Toolkit/USS/Inventar.uss" />
    <ui:VisualElement name="Inventar" class="Inventar bg-color text-color" style="background-color: rgb(4, 24, 1); color: rgb(4, 24, 1);flex-grow: 1; display: none;" >
        <ui:VisualElement name="tab-container text-color" class="nav-tabs">
            <ui:Button name="tab1" text="Samen" class="nav-link text-color" />
            <ui:Button name="tab2" text="Ungetrokene Pflanzen" class="nav-link text-color" />
            <ui:Button name="tab3" text="Getrokente Pflanzen" class="nav-link text-color" />
            <ui:VisualElement style="display: flex; justify-content: flex-end;">
                <ui:Button name="close-button" class="text-color" text="X"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:ScrollView name="scroll-content" class="text-color" style="margin-top: 20px;">
            <ui:VisualElement name= "tab-content1" class="text-color tab-content" style="flex-direction: row; justify-content: space-around;">
                
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:ScrollView name="scroll-content" class="text-color" style="margin-top: 20px;">
            <ui:VisualElement name= "tab-content2" class="text-color tab-content" style="flex-direction: row; justify-content: space-around;">
                
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:ScrollView name="scroll-content" class="text-color" style="margin-top: 20px;">
            <ui:VisualElement name= "tab-content3" class="text-color tab-content" style="flex-direction: row; justify-content: space-around;">
                
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
