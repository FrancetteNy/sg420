<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="chat-member-container" style="flex-direction: row; margin-top: 3px; margin-right: 3px; margin-bottom: 3px; margin-left: 3px; padding-top: 3px; padding-right: 3px; padding-bottom: 3px; padding-left: 3px; flex-shrink: 0;">
        <ui:VisualElement name="avatar-container" style="width: 20%; justify-content: center;">
            <ui:VisualElement name="chat-member-avatar" style="width: 45px; height: 48px; align-self: center;" />
        </ui:VisualElement>
        <ui:Label text="Label" name="chat-member-name" style="width: 80%; -unity-text-align: middle-left;" />
    </ui:VisualElement>
</ui:UXML>
