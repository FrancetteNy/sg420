<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI%20Toolkit/USS/ChatView.uss?fileID=7433441132597879392&amp;guid=34e7df1203e973346acf97beb165fca8&amp;type=3#ChatView" />
    <ui:VisualElement name="ChatView" class="chatview">
        <ui:ListView name="chat-member-list" allow-add="false" allow-remove="false" style="width: 20%;" />
        <ui:VisualElement style="width: 80%;">
            <ui:ListView name="chat-list" selection-type="None" focusable="false" allow-add="false" allow-remove="false" virtualization-method="DynamicHeight" style="width: 100%; height: 70%;" />
            <SG420UILibrary.CenteredScrollView style="width: 100%; height: 30%;" />
        </ui:VisualElement>
        <ui:Button text="X" name="close-button" style="top: 0; right: 0; position: absolute; width: 25px; height: 25px; background-color: rgb(37, 85, 35);" />
    </ui:VisualElement>
</ui:UXML>
