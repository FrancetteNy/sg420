<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI%20Toolkit/USS/globals.uss?fileID=7433441132597879392&amp;guid=3e712312a89df5142a020cb0d117628d&amp;type=3#globals" />
    <ui:VisualElement name="HUD" style="flex-grow: 1; justify-content: flex-end;">
        <ui:VisualElement name="VisualElement" style="flex-direction: row; justify-content: space-between;">
            <ui:Label text="Tag 1" name="current-day-label" style="background-color: rgba(0, 0, 0, 0);" />
            <ui:Button text="Spiel speichern" name="save-game-button" />
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1; height: 40px;" />
        <ui:VisualElement name="VisualElement" style="flex-direction: row; justify-content: space-between; align-items: flex-end; flex-wrap: wrap;">
            <ui:VisualElement style="flex-grow: 1; flex-direction: column-reverse;">
                <ui:Label text="getrocknet : 0" name="Getrocknet" class="hud-label" />
                <ui:Label text="Score : 0" name="Score" class="hud-label" />
                <ui:Label text="Ernte : 0" name="Ernte" class="hud-label" />
            </ui:VisualElement>
            <ui:Button text="Nächsten Tag starten" name="update-day-button" style="margin-right: 10px; margin-bottom: 10px; height: 50px; flex-direction: row;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
