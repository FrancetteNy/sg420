<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI%20Toolkit/USS/DetailView.uss?fileID=7433441132597879392&amp;guid=5a6aaa73482568247a7b6bebc707b661&amp;type=3#DetailView" />
    <ui:VisualElement name="DetailView" style="flex-grow: 1; display: none;">
        <ui:VisualElement name="background" enabled="true" style="background-color: rgb(147, 147, 147); flex-grow: 1; display: flex; flex-direction: row;">
            <ui:VisualElement name="left-column" style="width: 400px;">
                <ui:Image name="plant-view" enabled="true" class="block" style="position: relative; -unity-background-scale-mode: scale-to-fit; height: 390px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
                    <ui:VisualElement name="VisualElement" style="flex-grow: 1; border-top-width: 4px; border-right-width: 4px; border-bottom-width: 4px; border-left-width: 4px; border-top-left-radius: 14px; border-top-right-radius: 14px; border-bottom-right-radius: 14px; border-bottom-left-radius: 14px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); margin-top: -5px; margin-right: -5px; margin-bottom: -5px; margin-left: -5px;">
                        <ui:VisualElement name="rotate-control-buttons" style="flex-grow: 1; position: absolute; height: 90px; width: 90px; top: 288px; left: 124px;">
                            <ui:VisualElement name="first-row" class="d-pad-row">
                                <ui:VisualElement name="spacer" class="d-pad-button" />
                                <ui:Button name="rotate-up-button" icon-image="project://database/Assets/Art/Textures/arrow-up-bold.png?fileID=2800000&amp;guid=59c2804fd52a19240a67f773bfe16839&amp;type=3#arrow-up-bold" class="d-pad-button no-spacing no-background" />
                            </ui:VisualElement>
                            <ui:VisualElement name="second-row" class="d-pad-row">
                                <ui:Button name="rotate-left-button" icon-image="project://database/Assets/Art/Textures/arrow-up-left-bold.png?fileID=2800000&amp;guid=f2b885dcdf233b342ba4adeee7a552ba&amp;type=3#arrow-up-left-bold" class="d-pad-button no-spacing no-background" />
                                <ui:VisualElement name="spacer" class="d-pad-button" />
                                <ui:Button name="rotate-right-button" icon-image="project://database/Assets/Art/Textures/arrow-up-right-bold.png?fileID=2800000&amp;guid=fccd706e1f105fa4db11403ada5e84d9&amp;type=3#arrow-up-right-bold" class="d-pad-button no-spacing no-background" />
                            </ui:VisualElement>
                            <ui:VisualElement name="third-row" class="d-pad-row">
                                <ui:VisualElement name="spacer" class="d-pad-button" />
                                <ui:Button name="rotate-down-button" icon-image="project://database/Assets/Art/Textures/arrow-down-bold.png?fileID=2800000&amp;guid=6a9b37e4993dcdb4585ce71605c167e6&amp;type=3#arrow-down-bold" class="d-pad-button no-spacing no-background" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="camera-control-buttons" style="flex-grow: 1; position: absolute; height: 90px; width: 90px; top: 288px; left: 238px;">
                            <ui:VisualElement name="first-row" class="d-pad-row">
                                <ui:VisualElement name="spacer" class="d-pad-button" />
                                <ui:Button name="move-up-button" icon-image="project://database/Assets/Art/Textures/arrow-up.png?fileID=2800000&amp;guid=fa4e6ae8518742c41a3ca618f359dbcf&amp;type=3#arrow-up" class="d-pad-button no-spacing no-background" />
                            </ui:VisualElement>
                            <ui:VisualElement name="second-row" class="d-pad-row">
                                <ui:Button name="move-left-button" icon-image="project://database/Assets/Art/Textures/arrow-left.png?fileID=2800000&amp;guid=93074179b0d0d634b85df81e2b159083&amp;type=3#arrow-left" class="d-pad-button no-spacing no-background" />
                                <ui:VisualElement name="spacer" class="d-pad-button" />
                                <ui:Button name="move-right-button" icon-image="project://database/Assets/Art/Textures/arrow-right.png?fileID=2800000&amp;guid=f3762ec4da8391d4cb5bf6e4c96bdc5b&amp;type=3#arrow-right" class="d-pad-button no-spacing no-background" />
                            </ui:VisualElement>
                            <ui:VisualElement name="third-row" class="d-pad-row">
                                <ui:VisualElement name="spacer" class="d-pad-button" />
                                <ui:Button name="move-down-button" icon-image="project://database/Assets/Art/Textures/arrow-down.png?fileID=2800000&amp;guid=8120d92f71ff08f40a9ac0c372dc8b55&amp;type=3#arrow-down" class="d-pad-button no-spacing no-background" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="zoom-control-buttons" style="position: absolute; top: 35px; left: 331px; width: 40px; height: 80px;">
                            <ui:Button name="zoom-in-button" icon-image="project://database/Assets/Art/Textures/magnify-plus.png?fileID=2800000&amp;guid=d984076e25c756941b526b134c93e334&amp;type=3#magnify-plus" class="no-spacing no-background" style="height: 50%;" />
                            <ui:Button name="zoom-out-button" icon-image="project://database/Assets/Art/Textures/magnify-minus.png?fileID=2800000&amp;guid=c0d63cf30cab5dd4e95e9e520d1ae63c&amp;type=3#magnify-minus" class="no-spacing no-background" style="height: 50%;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:Image>
                <ui:VisualElement name="soil" class="block" style="flex-grow: 1;">
                    <ui:Label text="Bodenwerte" name="title" class="block-header" />
                    <ui:VisualElement name="water" class="name-and-value" style="flex-grow: 1; flex-direction: row;">
                        <ui:Label text="Wasser" name="name" class="property-text" />
                        <ui:Label name="value" text="-" class="property-text" />
                    </ui:VisualElement>
                    <ui:VisualElement name="nutrients" class="name-and-value" style="flex-grow: 1; flex-direction: row;">
                        <ui:Label text="Nährstoffe" name="name" class="property-text" />
                        <ui:Label name="value" text="-" class="property-text" />
                    </ui:VisualElement>
                    <ui:VisualElement name="potsize" class="name-and-value" style="flex-grow: 1; flex-direction: row;">
                        <ui:Label text="Topfgröße" name="name" class="property-text" />
                        <ui:Label name="value" text="-" class="property-text" />
                    </ui:VisualElement>
                    <ui:VisualElement name="potsize" class="name-and-value" style="flex-grow: 1; flex-direction: row;">
                        <ui:Button text="Umtopfen" name="open-change-pot-submenu-button" style="flex-grow: 1;" />
                        <ui:Button text="Gießen" name="open-watering-submenu-button" style="flex-grow: 1;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="right-column" style="flex-grow: 2; flex-shrink: 1;">
                <ui:VisualElement name="controls" style="height: 5%;">
                    <ui:Button text="X" name="close-button" style="align-self: flex-end;" />
                </ui:VisualElement>
                <ui:VisualElement name="plant" class="block" style="flex-grow: 1; flex-shrink: 0; max-height: 47.5%;">
                    <ui:VisualElement name= "plantinfo" style="flex-grow: 1; flex-direction: row;">
                        <ui:VisualElement name="left" style="flex-grow: 1; flex-direction: column; max-width: 50%;">
                            <ui:VisualElement name="growthStage" class="name-and-value" style="flex-grow: 1; flex-direction: row;">
                                <ui:Label text="Phase" name="name" class="property-text" />
                                <ui:Label name="value" text="-" class="property-text" />
                            </ui:VisualElement>
                            <ui:VisualElement name="strain" class="name-and-value" style="flex-grow: 1; flex-direction: row;">
                                <ui:Label text="Sorte" name="name" class="property-text" />
                                <ui:Label name="value" text="-" class="property-text" />
                            </ui:VisualElement>
                            <ui:VisualElement name="sex" class="name-and-value" style="flex-grow: 1; flex-direction: row;">
                                <ui:Label text="Geschlecht" name="name" class="property-text" />
                                <ui:Label name="value" text="-" class="property-text" style="display: none;" />
                                <ui:Button text="Geschlecht Bestimmen" name="start-sexing-button" class="property-text" style="height: 50%; align-self: center;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="right" style="flex-grow: 1; max-width: 50%;">
                            <ui:VisualElement name="age" class="name-and-value" style="flex-grow: 1; flex-direction: row;">
                                <ui:Label text="Alter" name="name" class="property-text" />
                                <ui:Label name="value" text="-" class="property-text" />
                            </ui:VisualElement>
                            <ui:VisualElement name="empty" class="name-and-value" style="flex-grow: 1; flex-direction: row;">
                                <ui:Label text="-" name="name" class="property-text" />
                                <ui:Label name="value" text="-" class="property-text" />
                            </ui:VisualElement>
                            <ui:VisualElement name="empty" class="name-and-value" style="flex-grow: 1; flex-direction: row;">
                                <ui:Label text="-" name="name" class="property-text" />
                                <ui:Label name="value" text="-" class="property-text" />
                            </ui:VisualElement>
                        </ui:VisualElement>  
                    </ui:VisualElement> 
                    <ui:VisualElement name="popup-container" style="background-color: rgb(10, 9, 9),position: absolute; top: 30%; width: 30%; height: 50%; background-color: rgba(0, 0, 0, 0.5); justify-content: center; align-items: center;">
                            <ui:VisualElement name="popup-content" style=" padding: 20px; border-radius: 5px;">
                                <ui:Label name="popup-message" text="Default Message" style="font-size: 18px; text-align: center; margin-bottom: 20px;" />
                                <ui:Button name="popup-close-button" text="OK" style="align-self: center;" />
                            </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="seed-selection-container" style=" flex-direction: column; margin-top: 10px;">
                        <ui:Label name="SamenAuswählen" text="Samen auswählen :" class="property-text" style="margin-bottom: 5px;" />
                        <ui:DropdownField name="seed-type-dropdown" choices="Sativa,Indica,Ruderalis" style="width: 50%;"/>
                        <ui:Button name="confirm-seed-button" text="Anpflanzen" style="width: 50%; " />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="wiki" class="block" style="flex-grow: 1; max-height: 47.5%; flex-shrink: 0;">
                    <ui:Label text="Enzyklopädie" name="title" class="block-header" />
                    <ui:Label text="Dummy Text" name="wiki-text" style="font-size: 20px;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="previous-plant-button" icon-image="project://database/Assets/Art/Textures/chevron-left-circle-outline.png?fileID=2800000&amp;guid=dabda778f4ff92c4792236dca892c7a3&amp;type=3#chevron-left-circle-outline" class="button switch-plant-button no-background" style="position: absolute; top: 45%; left: 0; bottom: auto; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
            <ui:Button name="next-plant-button" icon-image="project://database/Assets/Art/Textures/chevron-right-circle-outline.png?fileID=2800000&amp;guid=7a5c6d966bab47e45a2f621b28a31819&amp;type=3#chevron-right-circle-outline" class="switch-plant-button no-background" style="position: absolute; right: 0; top: 45%; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
            <ui:VisualElement name="submenues" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; justify-content: center; background-color: rgba(0, 0, 0, 0.46); display: none;">
                <ui:VisualElement name="watering-submenu" style="width: 75%; align-self: center; background-color: rgb(185, 185, 185); height: 75%; display: none;">
                    <ui:VisualElement name="submenucontrols" style="flex-direction: row; justify-content: flex-end;">
                        <ui:Button text="X" name="close-watering-submenu-button" />
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 1;">
                        <ui:Label text="Total ein cooles Bild, was irgendwas mit gießen zu tun hat" />
                    </ui:VisualElement>
                    <ui:VisualElement name="water-slider-with-label" style="flex-direction: row;">
                        <ui:Slider label="Wasser" value="10.12" high-value="20" inverted="false" low-value="1" name="water-slider" fill="true" style="flex-grow: 1;" />
                        <ui:Label text="10" name="water-value-label" style="width: 50px;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="fertilizer-slider-with-label" style="flex-direction: row;">
                        <ui:Slider label="Dünger" value="0" high-value="15" inverted="false" low-value="0" name="fertilizer-slider" fill="true" style="flex-grow: 1;" />
                        <ui:Label text="0" name="fertilizer-value-label" style="width: 50px;" />
                    </ui:VisualElement>
                    <ui:Button text="Gießen" name="water-plant-button" />
                </ui:VisualElement>
                <ui:VisualElement name="change-pot-submenu" style="width: 75%; align-self: center; background-color: rgb(185, 185, 185); height: 75%; display: none;">
                    <ui:VisualElement name="submenucontrols" style="flex-direction: row; justify-content: flex-end;">
                        <ui:Button text="X" name="close-change-pot-submenu-button" />
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-grow: 1;">
                        <ui:Button text="In Anzuchtstopf setzen" name="change-to-cultivation-pot-button" />
                        <ui:Button text="In einen kleinen Topf setzen" name="change-to-small-pot-button" />
                        <ui:Button text="In einen mittleren Topf setzen" name="change-to-medium-pot-button" />
                        <ui:Button text="In einen großen Topf setzen" name="change-to-large-pot-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
