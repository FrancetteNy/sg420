<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI%20Toolkit/USS/Inventar.uss?fileID=7433441132597879392&amp;guid=59a3109c6c2ba4315914910ae08f9c57&amp;type=3#Inventar" />
    <Style src="project://database/Assets/Resources/UI%20Toolkit/USS/DetailView.uss?fileID=7433441132597879392&amp;guid=5a6aaa73482568247a7b6bebc707b661&amp;type=3#DetailView" />
    <ui:VisualElement name="Inventory" class="bg-color text-color inventory-window">
        <ui:VisualElement name="tab-container text-color" class="nav-tabs">
            <ui:Button name="seed-inventory-button" text="Samen" class="nav-link" />
            <ui:Button name="harvested-plants-inventory-button" text="Ungetrocknete Pflanzen" class="nav-link" />
            <ui:Button name="dried-plants-inventory-button" text="Getrocknete Pflanzen" class="nav-link" />
            <ui:Button name="close-button" text="X" style="border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; background-color: rgb(37, 85, 35); font-size: 15px; -unity-font-style: bold; width: 40px; position: absolute; top: 1px; right: 2px; display: flex;" />
        </ui:VisualElement>
        <ui:ScrollView name="inventory" style="margin-top: 20px;">
            <ui:VisualElement name="scroll-content" class="tab-content" style="flex-direction: row;" />
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
