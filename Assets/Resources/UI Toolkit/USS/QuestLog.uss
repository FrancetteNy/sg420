#QuestLog {
    flex-grow: 1;
    flex-direction: row;
    width: 98%;
    height: 98%;
    background-color: rgb(255, 255, 255);
    right: 1%;
    bottom: 1%;
    left: 1%;
    top: 1%;
    position: absolute;
    border-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-radius: 15px;
}

#quest-listview {
    height: 96%;
    width: 15%;
    left: 2%;
    top: 2%;
    bottom: 2%;
}

#search-bar {
    height: 3%;
    border-radius: 15px;
    border-width: 2px;
    border-color: rgb(126, 126, 126);
    font-size: 15px;
}

#entry-scroll-view {
    height: 96%;
    width: 75%;
    left: 4%;
    top: 2%;
}

.objective {
    margin-top: 5px;
    margin-right: 3px;
    margin-bottom: 5px;
    margin-left: 3px;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
}

.objective--done {
}

.objective--active {
}

.objective--future {
}

.h1 {
    font-size: 30;
    font-wheight: bold;
}

.h2 {
    font-size: 20;
    font-wheight: bold;
}

.h3 {
    font-size: 15;
    font-wheight: bold;
}

.objective-description {
    margin-left: 30px;
}
