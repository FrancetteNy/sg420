#QuestLog {
    flex-grow: 1;
    flex-direction: row;
    right: 10%;
    bottom: 10%;
    left: 10%;
    top: 10%;
    position: absolute;
    border-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-radius: 15px;
}

#quest-listview {
    height: 96%;
    width: 25%;
    left: 2%;
    top: 2%;
    bottom: 2%;
    -unity-text-align: middle-center;
}

#entry-scroll-view {
    height: 96%;
    width: 69%;
    left: 4%;
    top: 2%;
}

.objective {
    margin-top: 5px;
    margin-right: 3px;
    margin-bottom: 5px;
    margin-left: 3px;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    flex-direction: row;
    justify-content: space-between;
}

.objective--done {
}

.objective--active {
}

.objective--future {
}

.h1 {
    font-size: 30;
    font-wheight: bold;
}

.h2 {
    font-size: 20;
    font-wheight: bold;
}

.h3 {
    font-size: 15;
    font-wheight: bold;
}

.objective-description {
    margin-left: 30px;
}

.quest-label {
    height: 50px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    font-size: 20px;
    -unity-font-style: bold;
}
