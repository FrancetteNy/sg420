.modal-btn {
    width: 50%;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 24px;
    transition-duration: 0.3s;
    flex-direction: column;
    flex-wrap: nowrap;
    flex-grow: 1;
    flex-basis: 1px;
}

.unity-button.cancel {
    background-color: rgb(255, 64, 64);
}

.unity-button.confirm {
    background-color: var(--color-interactable);
    border-left-color: var(--color-interactable);
    border-right-color: var(--color-interactable);
    border-top-color: var(--color-interactable);
    border-bottom-color: var(--color-interactable);
}

.unity-button.cancel:hover {
    background-color: rgba(255, 64, 64, 0);
    color: rgb(255, 64, 64);
}

.unity-button.confirm:hover {
    background-color: rgba(0, 0, 0, 0);
    border-left-color: var(--color-interactable);
    border-right-color: var(--color-interactable);
    border-top-color: var(--color-interactable);
    border-bottom-color: var(--color-interactable);
    color: var(--color-interactable);
}

.modal {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.47);
    justify-content: center;
    align-items: center;
    flex-direction: column;
    align-self: auto;
    align-content: auto;
    transition-duration: 0.5s;
}

.modal.hide {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.47);
    justify-content: center;
    align-items: center;
    flex-direction: column;
    align-self: auto;
    align-content: auto;
    opacity: 0;
    transition-duration: 0.5s;
    visibility: hidden;
}

.unity-button.confirm.disabled {
}
