@import url("unity-theme://default");

.unity-base-field__input {
    background-color: rgb(37, 85, 35);
    border-color: rgb(0, 0, 0);
    border-radius: 8px;
    border-width: 3px;
    color: white
}

.unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(0, 0, 0);
}

.unity-base-dropdown .unity-scroll-view {
    background-color: rgb(37, 85, 35);
    border-color: rgb(0, 0, 0);
    border-radius: 8px;
    border-width: 3px;
    color: white;
}

.unity-scroll-view .unity-base-dropdown__item:hover {
    background-color:  rgb(50, 112, 47);
}

.unity-base-dropdown__checkmark {
    -unity-background-image-tint-color: rgb(0, 0, 0);
    width: 25px;
    height: 25px;
}